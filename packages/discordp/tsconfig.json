{
  "compilerOptions": {
    // es2023, not esnext: esnext emits decorators verbatim and no runtime can parse them yet
    "target": "es2023",
    "module": "nodenext",
    "strict": true,
    "declaration": true,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "build",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
