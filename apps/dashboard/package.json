{
  "name": "dashboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build",
    "start": "bun ./build/index.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "db:migrate": "drizzle-kit generate && bun run src/lib/server/migrate.ts",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "daisyui": "^5.7.16",
    "drizzle-kit": "^0.31.10",
    "svelte": "^5.56.1",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@iconify/svelte": "^5.2.2",
    "ai": "^7.0.68",
    "ai-sdk-pplx-agent": "^0.1.1",
    "better-auth": "^1.6.28",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.2"
  }
}
